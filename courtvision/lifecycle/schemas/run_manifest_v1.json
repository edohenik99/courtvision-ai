{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "courtvision.lifecycle.run_manifest.v1",
  "title": "CourtVision prediction run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prediction_run_id",
    "run_mode",
    "run_reason",
    "parent_run_id",
    "started_at_utc",
    "completed_at_utc",
    "operating_date",
    "operating_timezone",
    "git_commit_sha",
    "git_dirty",
    "working_tree_hash",
    "config_hash",
    "model_id",
    "model_version",
    "model_bundle_hash",
    "calibration_id",
    "calibration_version",
    "calibration_hash",
    "strategy_version",
    "pipeline_version",
    "python_version",
    "dependency_fingerprint",
    "input_manifest_hash",
    "reproducibility_level",
    "canonical_runtime_mode",
    "lifecycle_authority",
    "run_manifest_schema_version"
  ],
  "properties": {
    "prediction_run_id": {"type": "string"},
    "run_mode": {
      "enum": ["LIVE", "SHADOW", "RESEARCH", "BACKTEST", "COUNTERFACTUAL"]
    },
    "run_reason": {
      "type": ["string", "null"],
      "enum": ["SCHEDULED", "MANUAL", "RETRY", "RECOVERY", null]
    },
    "parent_run_id": {"type": ["string", "null"]},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "completed_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "operating_date": {"type": "string", "format": "date"},
    "operating_timezone": {"const": "America/Toronto"},
    "git_commit_sha": {"type": ["string", "null"]},
    "git_dirty": {"type": ["boolean", "null"]},
    "working_tree_hash": {"type": ["string", "null"]},
    "config_hash": {"type": ["string", "null"]},
    "model_id": {"type": ["string", "null"]},
    "model_version": {"type": ["string", "null"]},
    "model_bundle_hash": {"type": ["string", "null"]},
    "calibration_id": {"type": ["string", "null"]},
    "calibration_version": {"type": ["string", "null"]},
    "calibration_hash": {"type": ["string", "null"]},
    "strategy_version": {"type": ["string", "null"]},
    "pipeline_version": {"type": ["string", "null"]},
    "python_version": {"type": "string"},
    "dependency_fingerprint": {"type": ["string", "null"]},
    "input_manifest_hash": {"type": ["string", "null"]},
    "reproducibility_level": {"enum": ["FULL", "PARTIAL", "INSUFFICIENT"]},
    "canonical_runtime_mode": {"const": "LIVE"},
    "lifecycle_authority": {"const": "SHADOW_ONLY"},
    "run_manifest_schema_version": {"const": 1}
  }
}
