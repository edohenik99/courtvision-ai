# CourtVision Environment Configuration
# Copy this file to .env and fill in your actual API keys

# Data Provider Settings
# Priority order for providers (comma-separated): sportsdataio, balldontlie
# Default: balldontlie
DATA_PROVIDER_PRIORITY=balldontlie

# Enable automatic fallback to next provider on failure
# Default: true
ENABLE_PROVIDER_FALLBACK=true

# SportsDataIO API Key (NBA Data)
# Get your key from: https://sportsdata.io/developers/api-documentation/nba
SPORTSDATAIO_API_KEY=

# BallDontLie API Key (NBA Data)
# Get your key from: https://www.balldontlie.io/
BALLDONTLIE_API_KEY=

# Optional: Custom SportsDataIO base URL
# SPORTSDATAIO_BASE_URL=https://api.sportsdata.io/v3/nba
