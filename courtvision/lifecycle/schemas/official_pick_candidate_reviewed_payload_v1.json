{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "courtvision.lifecycle.official_pick_candidate_reviewed_payload.v1",
  "title": "CourtVision official pick candidate reviewed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_schema_version",
    "review_policy_version",
    "review_content_sha256",
    "candidate_snapshot_sha256",
    "operator_review"
  ],
  "properties": {
    "payload_schema_version": {"const": 1},
    "review_policy_version": {"const": "1.0"},
    "review_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operator_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "source_candidate_id",
        "source_record_kind",
        "review_status",
        "operator_decision",
        "approved_designation",
        "operator_id",
        "decision_reason",
        "reviewed_at",
        "review_run_id",
        "candidate_snapshot",
        "candidate_snapshot_sha256",
        "provenance",
        "idempotency_key",
        "schema_version",
        "record_kind"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "pattern": "^review_[0-9a-f]{32}$"
        },
        "source_candidate_id": {"type": "string", "minLength": 1},
        "source_record_kind": {"const": "MODEL_CANDIDATE"},
        "review_status": {"const": "COMMITTED"},
        "operator_decision": {
          "enum": ["APPROVED", "REJECTED", "DEFERRED", "EXPIRED"]
        },
        "approved_designation": {
          "enum": ["PAPER", "RESEARCH"]
        },
        "operator_id": {"type": "string", "minLength": 1},
        "decision_reason": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "review_run_id": {"type": "string", "minLength": 1},
        "candidate_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sport",
            "league",
            "event_id",
            "event_start_time",
            "prediction_date",
            "market_key",
            "selection",
            "line",
            "odds",
            "sportsbook",
            "player_id",
            "player_name",
            "team_id",
            "model_name",
            "model_version",
            "run_id",
            "designation",
            "source_candidate_id",
            "source_observation_id",
            "provenance",
            "record_kind"
          ],
          "properties": {
            "sport": {"type": "string", "minLength": 1},
            "league": {"type": "string", "minLength": 1},
            "event_id": {"type": "string", "minLength": 1},
            "event_start_time": {"type": "string", "format": "date-time"},
            "prediction_date": {"type": "string", "format": "date"},
            "market_key": {"type": "string", "minLength": 1},
            "selection": {
              "enum": ["OVER", "UNDER", "YES", "NO", "HOME", "AWAY"]
            },
            "line": {"type": "string"},
            "odds": {"type": "number"},
            "sportsbook": {"type": "string", "minLength": 1},
            "player_id": {"type": ["string", "null"]},
            "player_name": {"type": ["string", "null"]},
            "team_id": {"type": ["string", "null"]},
            "model_name": {"type": "string", "minLength": 1},
            "model_version": {"type": "string", "minLength": 1},
            "run_id": {"type": "string", "minLength": 1},
            "designation": {"enum": ["PAPER", "RESEARCH"]},
            "source_candidate_id": {"type": "string", "minLength": 1},
            "source_observation_id": {"type": "null"},
            "provenance": {"type": "object"},
            "record_kind": {"const": "MODEL_CANDIDATE"}
          }
        },
        "candidate_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provenance": {"type": "object"},
        "idempotency_key": {
          "type": "string",
          "pattern": "^oprevidem_[0-9a-f]{64}$"
        },
        "schema_version": {"const": 1},
        "record_kind": {"const": "OFFICIAL_PICK_CANDIDATE_REVIEW"}
      }
    }
  }
}
