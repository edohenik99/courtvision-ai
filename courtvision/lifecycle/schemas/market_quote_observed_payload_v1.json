{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "courtvision.lifecycle.market_quote_observed_payload.v1",
  "title": "CourtVision MARKET_QUOTE_OBSERVED payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_schema_version",
    "observation_identity",
    "prediction_run_id",
    "correlation_id",
    "canonical_event_id",
    "canonical_participant_id",
    "canonical_market_id",
    "canonical_bookmaker_id",
    "identity_resolution_status",
    "unresolved_identity_fields",
    "provider_name",
    "provider_event_id",
    "provider_participant_id",
    "provider_market_key",
    "provider_bookmaker_key",
    "sport",
    "league",
    "market_raw",
    "market_normalized",
    "selection",
    "line",
    "odds",
    "odds_format",
    "implied_probability",
    "is_live_market",
    "is_synthetic",
    "line_source",
    "provider_reported_at_utc",
    "market_observed_at_utc",
    "ingested_at_utc",
    "source_payload_ref",
    "source_payload_sha256",
    "evidence_retention_level",
    "normalization_version"
  ],
  "properties": {
    "payload_schema_version": {"const": 1},
    "observation_identity": {"type": "string"},
    "prediction_run_id": {"type": "string"},
    "correlation_id": {"type": "string"},
    "canonical_event_id": {"type": ["string", "null"]},
    "canonical_participant_id": {"type": ["string", "null"]},
    "canonical_market_id": {"type": ["string", "null"]},
    "canonical_bookmaker_id": {"type": ["string", "null"]},
    "identity_resolution_status": {
      "enum": ["RESOLVED", "UNRESOLVED", "CONFLICT"]
    },
    "unresolved_identity_fields": {
      "type": "array",
      "items": {"type": "string"}
    },
    "provider_name": {"type": "string"},
    "provider_event_id": {"type": ["string", "integer", "number", "null"]},
    "provider_participant_id": {"type": ["string", "integer", "number", "null"]},
    "provider_market_key": {"type": ["string", "null"]},
    "provider_bookmaker_key": {"type": ["string", "null"]},
    "sport": {"const": "BASKETBALL"},
    "league": {"const": "NBA"},
    "market_raw": {"type": ["string", "null"]},
    "market_normalized": {"type": ["string", "null"]},
    "selection": {"type": ["string", "null"]},
    "line": {"type": ["integer", "number", "null"]},
    "odds": {"type": ["integer", "number", "null"]},
    "odds_format": {"enum": ["AMERICAN", null]},
    "implied_probability": {"type": ["integer", "number", "null"]},
    "is_live_market": {"type": ["boolean", "null"]},
    "is_synthetic": {"type": ["boolean", "null"]},
    "line_source": {"type": ["string", "null"]},
    "provider_reported_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "market_observed_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "ingested_at_utc": {"type": "string", "format": "date-time"},
    "source_payload_ref": {"type": "string"},
    "source_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_retention_level": {
      "enum": ["FULL_RAW", "SANITIZED_RAW", "NORMALIZED_ONLY", "HASH_REFERENCE_ONLY"]
    },
    "normalization_version": {"type": "string"}
  }
}
